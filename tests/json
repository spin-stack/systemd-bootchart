#! /bin/sh
# Two boots are compared by numbers, not by eye: the sampler writes the chart's numbers as JSON
# beside the SVG, and a program reads them back.
set -e
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT
proc=$d/proc
mkdir -p "$proc/pressure" "$d/out"

put() {
        printf "$2" > "$proc/$1"
}

process() { # pid ppid comm cgroup runtime-ns waittime-ns
        mkdir -p "$proc/$1/task"
        put "$1/comm" "$3\n"
        put "$1/stat" "$1 ($3) S $2 0 0\n"
        put "$1/cgroup" "0::$4\n"
        put "$1/cmdline" ""
        put "$1/schedstat" "$5 $6 1\n"
        put "$1/io" "read_bytes: 4096\nwrite_bytes: 0\n"
}

put vmstat "pgpgin 10\npgpgout 20\n"
put schedstat "version 15\ntimestamp 0\ncpu0 0 0 0 0 0 0 1000 2000 3\n"
put pressure/cpu "some avg10=0.00 avg60=0.00 avg300=0.00 total=500\nfull avg10=0.00 avg60=0.00 avg300=0.00 total=0\n"
process 1 0 systemd /init.scope 5000000 0
# a kernel thread read before systemd mounted a cgroup hierarchy, when the kernel lists none
process 2 0 kthreadd / 0 0
put 2/cgroup ""
# a unit whose cgroup was removed before its process was read
process 63 1 systemd-user-se "/system.slice/systemd-user-sessions.service (deleted)" 1000000 0
# a name a JSON writer has to escape
process 62 1 'say "hi"\\' /system.slice/systemd-journald.service 1000000 250000

timeout 30 ./systemd-bootchart --proc "$proc" -o "$d/out" -r -c -f 100 -n 20

python3 - "$d"/out/*.json <<'PY'
import json, sys
chart = json.load(open(sys.argv[1]))
errors = []
def check(ok, what):
    if not ok:
        errors.append(what)
cols = chart["sample_columns"]
check(cols[:3] == ["time", "cpu_run_ns", "cpu_wait_ns"], "sample columns start with time, run and wait")
check(all(len(row) == len(cols) for row in chart["samples"]), "every sample row has every column")
check(len(chart["samples"]) >= 10, "a row for each of the samples taken")
times = [row[0] for row in chart["samples"]]
check(times == sorted(times), "samples are oldest first")
last = dict(zip(cols, chart["samples"][-1]))
check(last["cpu_run_ns"] == 1000 and last["pgpgin_kb"] == 10 and last["cpu_some_us"] == 500,
      "the counters as /proc/schedstat, vmstat and pressure have them: %s" % last)
ps = {p["pid"]: p for p in chart["processes"]}
j = ps.get(62, {})
check(j.get("name") == 'say "hi"\\', "the name read back: %r" % j.get("name"))
check(j.get("unit") == "systemd-journald.service", "the unit: %r" % j.get("unit"))
check(j.get("cgroup") == "/system.slice/systemd-journald.service", "the cgroup: %r" % j.get("cgroup"))
check(j.get("cpu_ns") == 1000000 and j.get("wait_ns") == 250000, "cpu and wait: %r" % j)
check(j.get("read_bytes") == 4096, "read_bytes: %r" % j.get("read_bytes"))
check(0 <= j.get("first_seen", -1) <= j.get("last_seen", -2), "first_seen before last_seen: %r" % j)
k = ps.get(2, {})
check(k.get("cgroup") == "/" and k.get("unit") == "/", "a kernel thread is in the root cgroup: %r" % k)
u = ps.get(63, {})
check(u.get("unit") == "systemd-user-sessions.service", "a removed cgroup's unit: %r" % u.get("unit"))
check(chart["hz"] == 100 and chart["relative"] is True, "the settings: %r" % chart)
for e in errors:
    print("not ok - " + e)
sys.exit(1 if errors else 0)
PY
