#! /bin/sh
# A process in a boot is named and placed after it starts: systemd's executor is exec'd through a
# file descriptor, so the kernel names it "9" until it execs the service, and it moves from
# init.scope into its unit's cgroup. The chart names it by what it became, under cgroup v2 and v1.
set -e
d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT
proc=$d/proc
mkdir -p "$proc" "$d/out"

# In place, as /proc changes: the sampler keeps a process's schedstat open and reads it again.
put() {
        printf "$2" > "$proc/$1"
}

process() { # pid ppid comm cgroup-file runtime-ns
        mkdir -p "$proc/$1/task"
        put "$1/comm" "$3\n"
        put "$1/stat" "$1 ($3) S $2 0 0\n"
        put "$1/cgroup" "$4"
        put "$1/cmdline" ""
        put "$1/schedstat" "$5 0 1\n"
}

put vmstat "pgpgin 0\npgpgout 0\n"
put schedstat "version 15\ntimestamp 0\ncpu0 0 0 0 0 0 0 1000 2000 3\n"
process 1 0 systemd "0::/init.scope\n" 5000000
process 62 1 9 "0::/init.scope\n" 1000000
process 70 1 9 "1:name=systemd:/init.scope\n0::/\n" 1000000
process 71 1 sshd "1:name=systemd:/system.slice/ssh.service\n" 2000000

timeout 30 ./systemd-bootchart --proc "$proc" -o "$d/out" -r -c -f 100 -n 50 &
sampler=$!
sleep 0.2
put 62/comm "systemd-journal\n"
put 62/cgroup "0::/system.slice/systemd-journald.service\n"
put 62/schedstat "3000000 0 2\n"
put 70/comm "systemd-logind\n"
put 70/cgroup "1:name=systemd:/system.slice/systemd-logind.service\n0::/\n"
put 70/schedstat "3000000 0 2\n"
wait $sampler

svg=$(echo "$d"/out/*.svg)
fail=0
expect() {
        grep -qF -- "$1" "$svg" || { echo "not ok - the chart has no $1"; fail=1; }
}
expect '<![CDATA[systemd-journal]]> [62]'
expect '<![CDATA[systemd-journald.service]]>'
expect '<![CDATA[systemd-logind]]> [70]'
expect '<![CDATA[systemd-logind.service]]>'
expect '<![CDATA[ssh.service]]>'
expect '<![CDATA[systemd-journald.service]]> (1 process)'
if grep -qF '<![CDATA[9]]>' "$svg"; then
        echo "not ok - a process is still named after the executor's descriptor"
        fail=1
fi
[ $fail -eq 0 ] || grep -F '[CDATA[' "$svg"
exit $fail
